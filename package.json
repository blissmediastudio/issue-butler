{
  "name": "issue-butler",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Self-hosted Discord bot that triages channel reports into GitHub issues",
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=packages/core && npm run build --workspace=packages/bot && npm run build --workspace=packages/admin-client",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "dev:bot": "npm run dev --workspace=packages/bot",
    "dev:client": "npm run dev --workspace=packages/admin-client"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0"
  }
}
