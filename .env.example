# --- Required ---
# Discord Developer Portal → your application → Bot → Token
DISCORD_BOT_TOKEN=
# Discord Developer Portal → your application → General Information → Application ID
DISCORD_CLIENT_ID=

# --- GitHub App integration (optional; all six required together to enable it) ---
# One App registration serves every server that installs Issue Butler — see README for
# how to register it. Per-server repo access is granted through the /setup connect-github
# install flow, not through these variables.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Paste the PEM private key with real newlines escaped as \n (most .env / secret stores
# can't hold literal newlines). Example: -----BEGIN RSA PRIVATE KEY-----\nMIIEow...\n-----END...
GITHUB_APP_PRIVATE_KEY=
# From the App's Webhook secret field.
GITHUB_WEBHOOK_SECRET=
# Any long random string, used to sign the install flow's state param.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
SESSION_SECRET=
# The public HTTPS URL this bot is reachable at (GitHub needs to be able to reach
# PUBLIC_BASE_URL/webhooks/github and redirect back to PUBLIC_BASE_URL/connect/github/callback).
PUBLIC_BASE_URL=

# --- AI-assisted triage (optional; bring your own key) ---
# Without this, Issue Butler uses free keyword-based classification and a fixed
# clarifying-question bank. With it, an Anthropic model classifies reports and
# drives the back-and-forth conversation.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Admin dashboard (optional) ---
# A long random string. Required to expose the admin API / React dashboard at all.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=

# --- Misc ---
PORT=3001
DATABASE_PATH=./data/issue-butler.sqlite
MAX_ELABORATION_ROUNDS=2
LOG_LEVEL=info
